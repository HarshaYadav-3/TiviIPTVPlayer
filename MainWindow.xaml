<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TiviIPTVPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TiviIPTVPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TiviIPTVPlayer"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: app identity + primary navigation (mockup row 1) -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Padding="16,0,8,0"
            ColumnDefinitions="Auto,Auto,*,Auto"
            BorderBrush="{ThemeResource HeaderSeparatorBrush}">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AppAccentBrush}" />
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="TiviIPTVPlayer" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                <Button
                    x:Name="NavPlayerButton"
                    Click="OnNavClick"
                    FontSize="14"
                    Tag="player">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE714;" />
                        <TextBlock FontSize="14" Text="Player" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="NavPlaylistsButton"
                    Click="OnNavClick"
                    Tag="playlists">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                        <TextBlock FontSize="14" Text="Playlists" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="NavSettingsButton"
                    Click="OnNavClick"
                    Tag="settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock FontSize="14" Text="Settings" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="NavAboutButton"
                    Click="OnNavClick"
                    Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <TextBlock FontSize="14" Text="About" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button
                x:Name="ThemeToggleButton"
                Grid.Column="3"
                Margin="0,0,8,0"
                Padding="8,6"
                VerticalAlignment="Center"
                Click="OnThemeToggleClick"
                ToolTipService.ToolTip="System theme">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="ThemeGlyphIcon" FontSize="16" VerticalAlignment="Center" Glyph="&#xF08C;" />
                    <TextBlock x:Name="ThemeTextBlock" VerticalAlignment="Center" FontSize="14" Text="System" />
                </StackPanel>
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
