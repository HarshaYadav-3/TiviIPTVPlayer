<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TiviIPTVPlayer.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:TiviIPTVPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TiviIPTVPlayer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TiviIPTVPlayer.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="SourceRowTemplate" x:DataType="models:PlaylistSource">
            <StackPanel Spacing="6" Margin="4,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Glyph="{x:Bind conv:PlaylistConverters.ActiveGlyph(Id)}"
                        Visibility="{x:Bind conv:PlaylistConverters.ActiveVisibility(Id)}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind Name}" />
                    <Border
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#283B82F6"
                        CornerRadius="4"
                        Visibility="{x:Bind conv:PlaylistConverters.DefaultVisibility(IsDefault)}">
                        <TextBlock FontSize="14" Foreground="{ThemeResource AppAccentBrush}" Text="DEFAULT" />
                    </Border>
                    <Border
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleSurfaceBrush}"
                        CornerRadius="4">
                        <TextBlock FontSize="14" Foreground="{ThemeResource PanelHeaderTextBrush}" Text="{x:Bind KindLabel}" />
                    </Border>
                </StackPanel>

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                    Text="{x:Bind conv:PlaylistConverters.SourceDetail(KindLabel, ChannelCount, LastRefreshedUtc, EpgUrl)}"
                    TextWrapping="Wrap" />

                <TextBlock
                    FontSize="14"
                    Foreground="#FFF06464"
                    Text="{x:Bind LastError}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind conv:PlaylistConverters.ErrorVisibility(LastError)}" />

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                    Text="{x:Bind Url}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind conv:PlaylistConverters.ErrorVisibility(Url)}" />

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Button
                        Click="OnActivateClick"
                        FontSize="14"
                        IsEnabled="{x:Bind conv:PlaylistConverters.ActivateEnabled(Id)}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                            <TextBlock FontSize="14" Text="{x:Bind conv:PlaylistConverters.ActivateText(Id)}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRefreshItemClick" FontSize="14" ToolTipService.ToolTip="Reload channels from the source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            <TextBlock FontSize="14" Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnEpgClick" FontSize="14" ToolTipService.ToolTip="Set an XMLTV EPG URL for this playlist">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE787;" />
                            <TextBlock FontSize="14" Text="EPG URL" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRenameClick" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8AC;" />
                            <TextBlock FontSize="14" Text="Rename" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnRemoveClick"
                        FontSize="14"
                        IsEnabled="{x:Bind conv:PlaylistConverters.RemoveEnabled(IsDefault)}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            <TextBlock FontSize="14" Text="Remove" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <ContentDialog
            x:Name="AddUrlDialog"
            Title="Add playlist from URL"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="False"
            PrimaryButtonClick="OnAddUrlConfirm"
            PrimaryButtonText="Add">
            <StackPanel Spacing="12" MinWidth="420">
                <TextBox
                    x:Name="AddUrlBox"
                    FontSize="14"
                    Header="Playlist URL (M3U / M3U8)"
                    PlaceholderText="https://example.com/playlist.m3u"
                    TextChanged="OnAddUrlBoxChanged" />
                <TextBox
                    x:Name="AddNameBox"
                    FontSize="14"
                    Header="Name (optional)"
                    PlaceholderText="My playlist" />
                <InfoBar
                    x:Name="AddUrlErrorBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
                <ProgressRing
                    x:Name="AddUrlProgress"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Left"
                    IsActive="False" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="EpgDialog"
            Title="EPG guide URL"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnEpgConfirm"
            PrimaryButtonText="Save">
            <StackPanel Spacing="12" MinWidth="440">
                <TextBlock
                    x:Name="EpgTargetName"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="EpgUrlBox"
                    FontSize="14"
                    Header="XMLTV URL (leave empty for no EPG)"
                    PlaceholderText="https://example.com/epg.xml" />
                <InfoBar
                    x:Name="EpgErrorBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
                <ProgressRing
                    x:Name="EpgProgress"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Left"
                    IsActive="False" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="RenameDialog"
            Title="Rename playlist"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonClick="OnRenameConfirm"
            PrimaryButtonText="Save">
            <StackPanel Spacing="12" MinWidth="380">
                <TextBox x:Name="RenameBox" FontSize="14" Header="Playlist name" MaxLength="60" />
            </StackPanel>
        </ContentDialog>
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Playlists" />
            <TextBlock
                FontSize="14"
                Foreground="{ThemeResource PanelHeaderTextBrush}"
                Text="Manage M3U playlist sources. The active playlist feeds the channel list on the Player page." />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,12"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnAddUrlClick" FontSize="14" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE71B;" />
                    <TextBlock FontSize="14" Text="Add URL" />
                </StackPanel>
            </Button>
            <Button Click="OnOpenFileClick" FontSize="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                    <TextBlock FontSize="14" Text="Import file" />
                </StackPanel>
            </Button>
            <ProgressRing
                x:Name="PageBusyRing"
                Width="22"
                Height="22"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsActive="False" />
            <TextBlock
                x:Name="PageBusyText"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource PanelHeaderTextBrush}"
                Text="" />
        </StackPanel>

        <ListView
            Grid.Row="2"
            x:Name="SourcesList"
            ItemTemplate="{StaticResource SourceRowTemplate}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
