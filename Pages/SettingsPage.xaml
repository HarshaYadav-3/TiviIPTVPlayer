<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TiviIPTVPlayer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TiviIPTVPlayer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />
                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                    Text="Playback, playlists, appearance and storage options." />
            </StackPanel>

            <!-- Appearance -->
            <Border
                Padding="16"
                Background="{ThemeResource SidePanelBrush}"
                BorderBrush="{ThemeResource SidePanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Appearance" />
                    <ComboBox
                        x:Name="ThemeCombo"
                        FontSize="14"
                        Header="Theme"
                        MinWidth="220"
                        SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="System" FontSize="14" Tag="Default" />
                        <ComboBoxItem Content="Light" FontSize="14" Tag="Light" />
                        <ComboBoxItem Content="Dark" FontSize="14" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Playback -->
            <Border
                Padding="16"
                Background="{ThemeResource SidePanelBrush}"
                BorderBrush="{ThemeResource SidePanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Playback" />
                    <ToggleSwitch
                        x:Name="ResumeToggle"
                        FontSize="14"
                        Header="Resume last channel"
                        OffContent="Start with an empty player"
                        OnContent="Continue where I left off"
                        Toggled="OnResumeToggled" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource PanelHeaderTextBrush}"
                        Text="Volume and mute state are always remembered automatically." />
                </StackPanel>
            </Border>

            <!-- Playlists & EPG -->
            <Border
                Padding="16"
                Background="{ThemeResource SidePanelBrush}"
                BorderBrush="{ThemeResource SidePanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Playlists &amp; EPG" />
                    <ToggleSwitch
                        x:Name="AutoRefreshToggle"
                        FontSize="14"
                        Header="Refresh playlist on launch"
                        OffContent="Use the cached channel list"
                        OnContent="Always reload from the source"
                        Toggled="OnAutoRefreshToggled" />
                    <ToggleSwitch
                        x:Name="LoadEpgToggle"
                        FontSize="14"
                        Header="Load EPG guide"
                        OffContent="Skip program guide downloads"
                        OnContent="Download the guide when the playlist provides one"
                        Toggled="OnLoadEpgToggled" />
                </StackPanel>
            </Border>

            <!-- System -->
            <Border
                Padding="16"
                Background="{ThemeResource SidePanelBrush}"
                BorderBrush="{ThemeResource SidePanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="System" />
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        FontSize="14"
                        Header="Run at Windows startup"
                        OffContent="Disabled"
                        OnContent="Enabled"
                        Toggled="OnStartupToggled" />
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border
                Padding="16"
                Background="{ThemeResource SidePanelBrush}"
                BorderBrush="{ThemeResource SidePanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Storage" />
                    <TextBlock
                        x:Name="CacheSizeText"
                        FontSize="14"
                        Foreground="{ThemeResource PanelHeaderTextBrush}"
                        Text="Playlist cache: calculating…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnClearCacheClick" FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xED62;" />
                                <TextBlock FontSize="14" Text="Clear playlist cache" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearFavoritesClick" FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                <TextBlock FontSize="14" Text="Clear favorites" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <InfoBar
                        x:Name="StorageInfoBar"
                        FontSize="14"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
