<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TiviIPTVPlayer.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:conv="using:TiviIPTVPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TiviIPTVPlayer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TiviIPTVPlayer.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CategoryRowTemplate" x:DataType="models:CategoryItem">
            <Grid Padding="10,8" ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{x:Bind Display}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                    Text="{x:Bind Count}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChannelRowTemplate" x:DataType="models:IptvChannel">
            <Grid
                MinHeight="48"
                Padding="8,4"
                ColumnDefinitions="44,*,40"
                ToolTipService.ToolTip="{x:Bind Name}">
                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="30"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleSurfaceBrush}"
                    CornerRadius="4">
                    <Image
                        Width="38"
                        Height="28"
                        Source="{x:Bind conv:ChannelConverters.Logo(TvgLogo), Mode=OneWay}"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    MinWidth="36"
                    MinHeight="36"
                    Padding="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind conv:ChannelConverters.FavoriteTooltip(IsFavorite), Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnStarClick"
                    ToolTipService.ToolTip="{x:Bind conv:ChannelConverters.FavoriteTooltip(IsFavorite), Mode=OneWay}">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource FavoriteStarBrush}"
                        Glyph="{x:Bind conv:ChannelConverters.StarGlyph(IsFavorite), Mode=OneWay}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SourceComboTemplate" x:DataType="models:PlaylistSource">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontSize="14" Text="{x:Bind Name}" />
                <TextBlock FontSize="14" Foreground="{ThemeResource PanelHeaderTextBrush}" Text="{x:Bind ChannelCount}" />
            </StackPanel>
        </DataTemplate>

        <!-- Add playlist from URL -->
        <ContentDialog
            x:Name="AddUrlDialog"
            Title="Add playlist from URL"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="False"
            PrimaryButtonClick="OnAddUrlConfirm"
            PrimaryButtonText="Add">
            <StackPanel Spacing="12" MinWidth="420">
                <TextBox
                    x:Name="AddUrlBox"
                    FontSize="14"
                    Header="Playlist URL (M3U / M3U8)"
                    PlaceholderText="https://example.com/playlist.m3u"
                    TextChanged="OnAddUrlBoxChanged" />
                <TextBox
                    x:Name="AddNameBox"
                    FontSize="14"
                    Header="Name (optional)"
                    PlaceholderText="My playlist" />
                <InfoBar
                    x:Name="AddUrlErrorBar"
                    IsClosable="False"
                    IsOpen="False"
                    FontSize="14"
                    Severity="Error" />
                <ProgressRing
                    x:Name="AddUrlProgress"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Left"
                    IsActive="False" />
            </StackPanel>
        </ContentDialog>

        <!-- Channel details + schedule -->
        <ContentDialog
            x:Name="ChannelDetailsDialog"
            Title="Channel details"
            CloseButtonText="Close"
            DefaultButton="Primary"
            PrimaryButtonText="Watch">
            <StackPanel Spacing="10" MinWidth="460" MaxWidth="560">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="96"
                        Height="60"
                        Background="{ThemeResource SubtleSurfaceBrush}"
                        CornerRadius="6">
                        <Image x:Name="DetailsLogo" Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="DetailsName"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailsGroup" FontSize="14" Foreground="{ThemeResource PanelHeaderTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="DetailsNowTitle" FontSize="14" FontWeight="SemiBold" Text="On now" />
                <TextBlock x:Name="DetailsNowText" FontSize="14" Foreground="{ThemeResource PanelHeaderTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailsNextTitle" FontSize="14" FontWeight="SemiBold" Text="Up next" />
                <TextBlock x:Name="DetailsNextText" FontSize="14" Foreground="{ThemeResource PanelHeaderTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailsDesc" FontSize="14" TextWrapping="Wrap" />

                <Button
                    x:Name="CopyUrlButton"
                    Click="OnCopyUrlClick"
                    FontSize="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock x:Name="CopyUrlText" FontSize="14" Text="Copy stream URL" />
                    </StackPanel>
                </Button>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Program guide" />
                <ScrollViewer MaxHeight="220">
                    <StackPanel x:Name="DetailsScheduleList" Spacing="6" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>
    </Page.Resources>

    <Grid x:Name="MainGrid" ColumnDefinitions="260,*,350" RowDefinitions="*,0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnSpaceAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- LEFT: categories + channels -->
        <Border
            x:Name="LeftPanel"
            Grid.Row="0"
            Grid.Column="0"
            Background="{ThemeResource SidePanelBrush}"
            BorderBrush="{ThemeResource SidePanelBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,2*,Auto,Auto,3*">
                <TextBlock Grid.Row="0" Style="{StaticResource PanelHeaderText}" Text="CATEGORIES" />
                <ListView
                    x:Name="CategoriesList"
                    Grid.Row="1"
                    ItemTemplate="{StaticResource CategoryRowTemplate}"
                    SelectionMode="Single"
                    SelectionChanged="OnCategorySelectionChanged" />
                <TextBlock Grid.Row="2" Style="{StaticResource PanelHeaderText}" Text="CHANNELS" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="3"
                    Margin="12,0,12,8"
                    FontSize="14"
                    PlaceholderText="Search channels…"
                    TextChanged="OnSearchChanged" />
                <Grid Grid.Row="4">
                    <ListView
                        x:Name="ChannelsList"
                        IsItemClickEnabled="True"
                        ItemClick="OnChannelItemClick"
                        ItemTemplate="{StaticResource ChannelRowTemplate}"
                        RightTapped="OnChannelsRightTapped"
                        SelectionMode="Single">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnMenuPlayClick" FontSize="14" Text="Play">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnMenuFavoriteClick" FontSize="14" Text="Toggle favorite">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnMenuDetailsClick" FontSize="14" Text="Details">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnMenuCopyUrlClick" FontSize="14" Text="Copy stream URL">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <StackPanel
                        x:Name="ChannelsLoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed">
                        <ProgressRing Width="32" Height="32" IsActive="True" />
                        <TextBlock x:Name="ChannelsLoadingText" FontSize="14" Text="Loading channels…" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ChannelsEmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon FontSize="28" Glyph="&#xE722;" Foreground="{ThemeResource PanelHeaderTextBrush}" />
                        <TextBlock x:Name="ChannelsEmptyText" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- CENTER: player + controls -->
        <Grid x:Name="PlayerArea" Grid.Row="0" Grid.Column="1" MinWidth="220">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="PlayerHost"
                Grid.Row="0"
                Margin="8,8,8,0"
                Background="Black"
                CornerRadius="8">
                <Grid>
                    <MediaPlayerElement
                        x:Name="VideoPlayer"
                        AreTransportControlsEnabled="False"
                        DoubleTapped="OnPlayerDoubleTapped"
                        Stretch="Uniform" />

                    <StackPanel
                        x:Name="LoadingOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Visibility="Collapsed">
                        <ProgressRing Width="40" Height="40" IsActive="True" />
                        <TextBlock x:Name="LoadingText" FontSize="16" Text="Opening stream…" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ErrorOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="36"
                            Foreground="#FFE81123"
                            Glyph="&#xE783;" />
                        <TextBlock x:Name="ErrorTitle" FontSize="18" FontWeight="SemiBold" Text="Playback failed" />
                        <TextBlock
                            x:Name="ErrorDetail"
                            MaxWidth="440"
                            FontSize="14"
                            Foreground="{ThemeResource MutedTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="RetryButton"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Click="OnRetryClick"
                            FontSize="14"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                <TextBlock FontSize="14" Text="Try again" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        x:Name="EmptyOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon FontSize="40" Foreground="{ThemeResource MutedGlyphBrush}" Glyph="&#xE7F4;" />
                        <TextBlock FontSize="18" Text="Select a channel to start watching" />
                        <TextBlock
                            x:Name="EmptyHint"
                            FontSize="14"
                            Foreground="{ThemeResource MutedGlyphBrush}"
                            Text="Pick a channel from the list, or manage playlists from the Playlists page." />
                    </StackPanel>

                    <Button
                        x:Name="ExitFullscreenButton"
                        Margin="0,16,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnExitFullscreenClick"
                        FontSize="14"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE73F;" />
                            <TextBlock FontSize="14" Text="Exit fullscreen (Esc)" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Playback controls + EPG line -->
            <StackPanel Grid.Row="1" Margin="8,10,8,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="PlayPauseButton"
                        Width="44"
                        Height="44"
                        Click="OnPlayPauseClick"
                        FontSize="14"
                        ToolTipService.ToolTip="Play / Pause (Space)">
                        <FontIcon x:Name="PlayPauseGlyph" FontSize="18" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="StopButton"
                        Width="44"
                        Height="44"
                        Click="OnStopClick"
                        FontSize="14"
                        ToolTipService.ToolTip="Stop">
                        <FontIcon FontSize="18" Glyph="&#xE71A;" />
                    </Button>
                    <Button
                        x:Name="SnapshotButton"
                        Width="44"
                        Height="44"
                        Click="OnSnapshotClick"
                        FontSize="14"
                        ToolTipService.ToolTip="Snapshot">
                        <FontIcon FontSize="18" Glyph="&#xE722;" />
                    </Button>
                    <Button
                        x:Name="FullscreenButton"
                        Width="44"
                        Height="44"
                        Click="OnFullscreenClick"
                        FontSize="14"
                        ToolTipService.ToolTip="Fullscreen">
                        <FontIcon FontSize="18" Glyph="&#xE740;" />
                    </Button>

                    <Button
                        x:Name="MuteButton"
                        Width="40"
                        Height="44"
                        Click="OnMuteClick"
                        FontSize="14"
                        ToolTipService.ToolTip="Mute / unmute">
                        <FontIcon x:Name="MuteGlyph" FontSize="18" Glyph="&#xE767;" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Width="140"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="OnVolumeChanged" />

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="NowChannelName"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text=""
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="EpgLine"
                    Margin="2,6,0,0"
                    FontSize="14"
                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                    Text=""
                    TextTrimming="CharacterEllipsis" />

                <InfoBar
                    x:Name="SnapshotBar"
                    Margin="0,6,0,0"
                    FontSize="14"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Success">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            x:Name="OpenSnapshotsFolderButton"
                            Click="OnOpenSnapshotsFolder"
                            FontSize="14"
                            Content="Open folder" />
                    </StackPanel>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- RIGHT: playlist management + now playing -->
        <Border
            x:Name="RightPanel"
            Grid.Row="0"
            Grid.Column="2"
            Background="{ThemeResource SidePanelBrush}"
            BorderBrush="{ThemeResource SidePanelBorderBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,0,16">
                    <TextBlock Style="{StaticResource PanelHeaderText}" Text="PLAYLIST" />
                    <StackPanel Margin="12,0,12,4" Spacing="8">
                        <ComboBox
                            x:Name="SourcesCombo"
                            MinWidth="220"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource SourceComboTemplate}"
                            FontSize="14"
                            PlaceholderText="Select playlist"
                            SelectionChanged="OnSourceComboChanged" />
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="RefreshButton"
                                    Click="OnRefreshClick"
                                    FontSize="14"
                                    ToolTipService.ToolTip="Reload this playlist from its source">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            x:Name="RefreshProgress"
                                            Width="16"
                                            Height="16"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <FontIcon x:Name="RefreshIcon" FontSize="16" Glyph="&#xE72C;" />
                                        <TextBlock FontSize="14" Text="Refresh" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="AddUrlButton"
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Click="OnAddUrlClick"
                                FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE71B;" />
                                    <TextBlock FontSize="14" Text="Add URL" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="OpenFileButton"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                Click="OnOpenFileClick"
                                FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                                    <TextBlock FontSize="14" Text="Open File" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="PlaylistStatusText"
                            FontSize="14"
                            Foreground="{ThemeResource PanelHeaderTextBrush}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Margin="12,18,12,6" Style="{StaticResource PanelHeaderText}" Text="NOW PLAYING" />
                    <StackPanel Margin="12,0,12,0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="88"
                                Height="56"
                                Background="{ThemeResource SubtleSurfaceBrush}"
                                CornerRadius="6">
                                <Image x:Name="NowLogo" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="NowName"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text=""
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="NowGroup"
                                    FontSize="14"
                                    Foreground="{ThemeResource PanelHeaderTextBrush}"
                                    Text="" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="On now" />
                            <TextBlock
                                x:Name="NowCurrentText"
                                FontSize="14"
                                Foreground="{ThemeResource PanelHeaderTextBrush}"
                                Text=""
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Up next" />
                            <TextBlock
                                x:Name="NowNextText"
                                FontSize="14"
                                Foreground="{ThemeResource PanelHeaderTextBrush}"
                                Text=""
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="NowDescText"
                            FontSize="14"
                            Opacity="0.85"
                            Text=""
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="ScheduleButton"
                                Click="OnScheduleClick"
                                FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE787;" />
                                    <TextBlock FontSize="14" Text="Full schedule" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="DetailsButton"
                                Click="OnDetailsClick"
                                FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                                    <TextBlock FontSize="14" Text="Channel details" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
